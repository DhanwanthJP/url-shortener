
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Url Shortener</title>
</head>
<body>
    <h1>Analytics</h1>

    <table>
        <thead>
            <th>S.No</th>
            <th>Short ID</th>
            <th>Total Visits</th>
            <th>Redirect URL</th>

        </thead>
        <tbody>
            <% entries.forEach( (element, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= element.shortId %></td>
                    <td><%= element.visitHistory.length %></td>
                    <td><%= element.redirectUrl %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>