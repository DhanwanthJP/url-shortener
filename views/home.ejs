<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Url Shortener</title>
</head>

<body>
    <h1>Hello from Server</h1>
    <ol>
        <h4>
            <% urls.forEach(url => { %>
                <li><a href="/url/<%= url.shortId %>"><%=url.shortUrl %></a> - <%= url.redirectUrl %></li>
            <%                           
            }); %>

        </h4>
    </ol>
</body>

</html>